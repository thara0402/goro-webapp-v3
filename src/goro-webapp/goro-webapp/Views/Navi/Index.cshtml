@model goro_webapp.Models.NaviViewModel

@{
    ViewData["Title"] = "近くの店舗を探す";
}

<h1 class="page-title">近くの店舗を探す</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <label for="query" class="form-label mb-0 text-secondary small fw-semibold">場所</label>
                <input type="text" name="query" id="query" value="@Model.Query" class="form-control form-control-sm w-auto" placeholder="場所を入力" />
                <button type="submit" class="btn btn-navy btn-sm">検索</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Query) && Model.Gourmets.Any())
{
    <div class="d-flex align-items-center mb-3">
        <span class="text-secondary small">最寄りの</span>
        <span class="badge bg-navy ms-1 me-1">@Model.Gourmets.Count()</span>
        <span class="text-secondary small">件</span>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="thead-navy">
                    <tr>
                        <th class="ps-3">Season</th>
                        <th>話</th>
                        <th>タイトル</th>
                        <th>店</th>
                        <th class="pe-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Gourmets)
                    {
                        <tr>
                            <td class="ps-3">@item.Season</td>
                            <td>@item.Episode</td>
                            <td>@item.Title</td>
                            <td>@item.Restaurant</td>
                            <td class="pe-3 text-end">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@Url.Action("Index", "Navi", new { query = Model.Query })" class="btn btn-outline-primary btn-sm">詳細</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.Query))
{
    <div class="alert alert-info" role="alert">
        「@Model.Query」の近くに該当する店舗が見つかりませんでした。
    </div>
}
